@page "/dec2hex"
@rendermode InteractiveServer

<PageTitle>Dec &rarr; Hex</PageTitle>

<h3>Decimal &rarr; Hexadecimal</h3>

<label for="inputDec">Десятичное число:</label>
<input type="number" id="inputDec" @bind="decNumber" @oninput="Convert" />

<p class="mt-3">
    **Шестнадцатеричное представление:** **@hexResult**
</p>

@code {
    private int decNumber = 0;
    private string hexResult = "0";

    private void Convert()
    {
        if (decNumber >= 0)
        {
            hexResult = decNumber.ToString("X");
        }
        else
        {
            hexResult = "Введите неотрицательное число";
        }
    }
}