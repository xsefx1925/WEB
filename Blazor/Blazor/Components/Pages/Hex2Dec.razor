@page "/hex2dec"
@rendermode InteractiveServer

<PageTitle>Hex &rarr; Dec</PageTitle>

<h3>Hexadecimal &rarr; Decimal</h3>

<label for="inputHex">Шестнадцатеричное число:</label>
<input type="text" id="inputHex" @bind="hexNumber" @oninput="Convert" />

<p class="mt-3">
    **Десятичное представление:** **@decResult**
</p>

@code {
    private string hexNumber = "0";
    private string decResult = "0";

    private void Convert()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(hexNumber))
            {
                decResult = "0";
                return;
            }

            // Пытаемся преобразовать строку в число
            int decimalValue = System.Convert.ToInt32(hexNumber, 16);
            decResult = decimalValue.ToString();
        }
        catch
        {
            decResult = "Ошибка: Неверный формат или слишком большое число";
        }
    }
}