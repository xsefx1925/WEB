@page "/dec2bin"
@rendermode InteractiveServer

<PageTitle>Dec &rarr; Bin</PageTitle>

<h3>Decimal &rarr; Binary</h3>

<label for="inputDec">Десятичное число:</label>
<input type="number" id="inputDec" @bind="decNumber" @oninput="Convert" />

<p class="mt-3">
    **Двоичное представление:** **@binResult**
</p>

@code {
    private int decNumber = 0;
    private string binResult = "0";

    private void Convert()
    {
        if (decNumber >= 0)
        {
            binResult = System.Convert.ToString(decNumber, 2);
        }
        else
        {
            binResult = "Введите неотрицательное число";
        }
    }
}
